# Arar Buluruz self-hosted production ENV CONTRACT — placeholders only.
# DO NOT deploy this file as-is. DO NOT commit generated secrets.
# Re-generate/re-verify exact variable names from the pinned Supabase release at activation.

# Release identity / audit
ARAR_APP_COMMIT_SHA=<PINNED_GITHUB_SHA>
ARAR_SUPABASE_RELEASE=<PINNED_SELF_HOSTED_RELEASE_OR_COMMIT>

# Public URLs
SUPABASE_PUBLIC_URL=https://<api-domain>
API_EXTERNAL_URL=https://<api-domain>/auth/v1
SITE_URL=https://<public-app-domain>

# Database / signing / server-only secrets
POSTGRES_PASSWORD=<SECRET_FROM_SERVER_SECRET_STORE>
JWT_SIGNING_MATERIAL=<SECRET_FROM_SERVER_SECRET_STORE>
PUBLIC_CLIENT_KEY=<GENERATED_PUBLIC_KEY>
SERVICE_ROLE_SECRET=<SERVER_ONLY_SECRET_NEVER_IN_BROWSER>

# Storage
LISTING_PHOTO_BUCKET=listing_photos
LISTING_PHOTO_MAX_BYTES=8388608
STORAGE_BACKUP_TARGET=<INDEPENDENT_OFF_VPS_DESTINATION>

# Backup encryption / manifest
BACKUP_ENCRYPTION_RECIPIENT=<OFFLINE_OR_SEPARATE_KEY_RECIPIENT>
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4

# Operator-owned values
OPS_ALERT_TARGET=<NON_SECRET_ALERT_ROUTE>
